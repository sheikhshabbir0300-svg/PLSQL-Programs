SET SERVEROUTPUT ON;
DECLARE
v_test BOOLEAN :=TRUE;
v_counter NUMBER :=0;
v_result NUMBER;
BEGIN
  WHILE v_test 
  LOOP
  v_counter :=v_counter + 1;
  v_result :=9 * v_counter;
  DBMS_OUTPUT.PUT_LINE('9'||'X'||v_counter||'='||v_result);
  -- LOOP TERMINATIO
  IF v_counter = 10
  THEN
    v_test := FALSE;
  END IF;
END LOOP;
DBMS_OUTPUT.PUT_LINE('Outside the loop');
END;
/
