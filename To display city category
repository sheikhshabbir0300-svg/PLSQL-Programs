--To Display city category
SET SERVEROUTPUT ON;
DECLARE
place VARCHAR2(10):='MULTAN';
BEGIN
IF (place='Lahore')
THEN
DBMS_OUTPUT.PUT_LINE( place ||' - City of Colleges');
ELSIF(place='Karachi')
THEN
DBMS_OUTPUT.PUT_LINE( place ||' - City of Lights');
ELSIF(place='Islamabad')
THEN
DBMS_OUTPUT.PUT_LINE( place||' - Capital of Punjab');
ELSE
DBMS_OUTPUT.PUT_LINE( place ||' - This is invalid input');
END IF;
DBMS_OUTPUT.PUT_LINE(' ❤️ Thanks for searching');
END;
/
